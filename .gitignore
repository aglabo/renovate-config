# default: ignore all files
*

# Allow README, LICENSE, CONTRIBUTING
!**/README*
!**/LICENSE*
!**/CONTRIBUTING*

# Allow .github directories
!.github/
!.github/**

# Allow other ignore
!*ignore

# Allow editorconfig
!**/.editorconfig

# Allow settings
!**/settings.json


## Root configs
!/package.json
!/pnpm-lock.yaml
!/renovate.json
!/lefthook.yml
!/dprint.jsonc
!/.shellspec
!/.mcp.json
!/**/CHANGELOG.md
!/Release-Note.md

## Projects directories
# config files
!/configs/
!/configs/**
!/configs/**/*.json
!/configs/**/*.yml
!/configs/**/*.yaml
!/configs/**/*.toml
!/configs/**/*.mjs



# allow shell scripts
!/scripts/
!/scripts/**
!/scripts/**/*.sh




# Website (allowlist details: aglabo.github.io/.gitignore)
!/aglabo.github.io/


## AI Agents
# claude code
!**/CLAUDE*.md
# allowlist details: .claude/.gitignore
!.claude/


##  Editor
#   VSCode
!.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
!.vscode/cspell*
!.vscode/cspell*/**


##  Git
# allow all gitignore
!**/.gitignore


## Deny rules (keep last)
# ��̍ċA allowlist (!/scripts/**, !.github/** �Ȃ�) �͍Ō�Ɉ�v�����K����
# �����ߤA�@���E�������܂ł��ĂђǐՑΏۂɂ��Ă��܂��B
# �������ēx���O���邱�̾Z�N�V��ݓ�ͤA�K���t�@�Cً�����ɒu�����ơB

#   OS specific files
.DS_Store
thumbs.db

#   logs, patches
**/*.log
**/*.diff
**/*.patch

#   history, cache
**/.history/
**/.cache/

#   backup/swap/temp
**/$~*
**/~*
**/*~
**/*.tmp
**/*.swp
**/*.lock

#   session files
**/*session.json
**/*session

#   .env files
**/.env*

#   temporary directories
**/temp/
**/tmp/

#   node
**/node_modules/
**/.pnpm-store/
